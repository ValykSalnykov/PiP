{
  "manifest_version": 3,
  "name": "DAO Tools+",
  "description": "Инструменты DAO для Planfix и Syrve: PiP на внутренних страницах, автологин и проверка серверов.",
  "version": "1.4.1",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "DAO Tools+",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "planfix/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://daologistics.duckdns.org/*",
    "https://hub.daolog.net/*",
    "https://dao.planfix.ua/*",
    "https://planfix-to-syrve.com:8000/*",
    "https://*.syrve.app/*",
    "https://pro.helpdeskeddy.com/*",
    "https://loyalty.syrve.live/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Переключить режим PiP для текущей вкладки"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.us-central1.hosted.app/*",
        "https://hub.daolog.net/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dao.planfix.ua/*"
      ],
      "js": [
        "content/planfix.js"
      ]
    },
    {
      "matches": [
        "https://*.syrve.app/*"
      ],
      "js": [
        "content/syrve-app-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.syrve.online/resto*",
        "https://*.daocloud.it/resto*",
        "http://*.daocloud.fun/resto*",
        "https://*.daocloud.fun/resto*"
      ],
      "js": [
        "content/syrve-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://loyalty.syrve.live/*"
      ],
      "js": [
        "content/loyalty-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pro.helpdeskeddy.com/*"
      ],
      "js": [
        "content/helpdeskeddy-autofill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage/pip-main.js",
        "inpage/pip-placeholder.css"
      ],
      "matches": [
        "https://*.us-central1.hosted.app/*",
        "https://hub.daolog.net/*"
      ]
    }
  ]
}